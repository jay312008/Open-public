{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ai/:route*",
      "destination": "/api/ai?route=:route*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
