# Supabase Configuration (Client-safe public keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side AI Gateway URL (Never put OpenAI/Gemini/Anthropic/NVIDIA keys in EXPO_PUBLIC_*!)
EXPO_PUBLIC_AI_GATEWAY_URL=https://your-project-id.supabase.co/functions/v1/ai-gateway

# Server-only secrets (set in Supabase Edge Functions / backend host, NEVER in client code or git):
# NVIDIA_API_KEY=nvapi-your-secret-key
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Optional: Testing credit system configuration
EXPO_PUBLIC_DEFAULT_TEST_CREDITS=250
