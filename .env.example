# Supabase Configuration (Client-safe public keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side AI Gateway URL (Never put OpenAI/Gemini/Anthropic keys in EXPO_PUBLIC_*!)
EXPO_PUBLIC_AI_GATEWAY_URL=https://your-ai-gateway.example.com/api/v1

# Optional: Testing credit system configuration
EXPO_PUBLIC_DEFAULT_TEST_CREDITS=250
